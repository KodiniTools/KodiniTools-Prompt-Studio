# --- Pflicht ---------------------------------------------------------------
# Passwortschutz der ganzen App (Basic Auth im Server selbst, nicht in Nginx).
# Mindestens 12 Zeichen. Ohne dieses Passwort startet der Server nicht.
AUTH_USER=kodini
AUTH_PASSWORD=

# Anthropic-Key für den Turbo-Modus. Leer = Turbo aus, Sofort-Modus läuft.
ANTHROPIC_API_KEY=

# --- Optional --------------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=8000
AI_TIMEOUT_MS=120000
HOST=127.0.0.1
PORT=3022
DATA_DIR=./data

# Nur für lokale Entwicklung: Passwortschutz abschalten (true). Nie auf dem VPS.
AUTH_DISABLED=false
